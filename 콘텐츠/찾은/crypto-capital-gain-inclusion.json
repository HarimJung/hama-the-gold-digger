  "plain": {
    "what": "Bitcoin is digital money you can buy and sell online. Say you sell it for a $10,000 profit in a regular account, meaning one with no tax shelter. Half of that profit, $5,000, gets added to your income for the year, and that $5,000 is taxed at your top rate.",
    "so_what": "If your Ontario taxable income in 2026 is between about $58,523 and $107,785, that one win costs you about $1,483 in tax, and it never comes back. The same gain inside a TFSA is not taxed at all.",
    "do": "Write down your 2026 taxable income and see which row you land in: under $53,891, or between about $58,523 and $107,785.",
    "words": [
      {
        "term": "bitcoin",
        "means": "digital money you can buy and sell online"
      },
      {
        "term": "capital gain",
        "means": "your profit when you sell for more than you paid"
      },
      {
        "term": "taxable income",
        "means": "the income the government counts when working out your tax"
      },
      {
        "term": "top rate",
        "means": "the tax rate on your last dollar of income"
      },
      {
        "term": "TFSA",
        "means": "a savings box where your gains are not taxed"
      },
      {
        "term": "non-registered account",
        "means": "a regular account with no tax shelter"
      },
      {
        "term": "surtax",
        "means": "an extra tax charged on top of your tax"
      }
    ]
